#include <windows.h>

// The CEF bootstrap verifies the signed bootstrap/client pair.  Keep this
// resource deliberately small; branding and signing happen in the release
// packaging step after the binary hash manifest is generated.
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PondLabs"
      VALUE "FileDescription", "roscord CEF browser host client"
      VALUE "InternalName", "client.dll"
      VALUE "OriginalFilename", "client.dll"
      VALUE "ProductName", "roscord"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
